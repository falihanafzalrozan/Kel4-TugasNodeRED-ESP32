  {
    "id": "c_suhu",
    "type": "comment",
    "z": "tab_gedung",
    "name": "Suhu: 4 ruangan dalam 1 chart (nama garis = nama ruang)",
    "info": "",
    "x": 270,
    "y": 40,
    "wires": []
  },
  {
    "id": "in_suhu",
    "type": "mqtt in",
    "z": "tab_gedung",
    "name": "Suhu semua ruang",
    "topic": "pens/klp4/+/temperature",
    "qos": "0",
    "datatype": "auto-detect",
    "broker": "broker_hivemq",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 160,
    "y": 100,
    "wires": [
      [
        "fn_nama_ruang",
        "dbg_suhu"
      ]
    ]
  },
  {
    "id": "fn_nama_ruang",
    "type": "function",
    "z": "tab_gedung",
    "name": "ambil nama ruang",
    "func": "// msg.topic masuk: \"pens/klp4/ruang2/temperature\"\nconst parts = msg.topic.split(\"/\");\nmsg.topic = parts[2];               // \"ruang2\" -> jadi nama garis di chart\nmsg.payload = Number(msg.payload);  // teks -> angka\nif (isNaN(msg.payload)) return null; // abaikan data yang bukan angka\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 410,
    "y": 100,
    "wires": [
      [
        "chart_suhu"
      ]
    ]
  },
  {
    "id": "chart_suhu",
    "type": "ui_chart",
    "z": "tab_gedung",
    "name": "Chart Suhu",
    "group": "ui_grp_suhu",
    "order": 1,
    "width": "12",
    "height": "6",
    "label": "Suhu Ruangan (°C)",
    "chartType": "line",
    "legend": "true",
    "xformat": "HH:mm:ss",
    "interpolate": "linear",
    "nodata": "Menunggu data...",
    "dot": false,
    "ymin": "",
    "ymax": "",
    "removeOlder": "10",
    "removeOlderPoints": "",
    "removeOlderUnit": "60",
    "cutout": 0,
    "useOneColor": false,
    "useUTC": false,
    "colors": [
